# Python
__pycache__/
*.py[cod]
.venv/
venv/

# local runtime artefacts
exports/*
!exports/.gitkeep
ingest/
tools/
*.log

# application state: accounts, saved papers, activity log (server-owned, never
# hand-edited, and it must never be pushed)
data/app.sqlite
data/app.sqlite-wal
data/app.sqlite-shm

# recycle bins: transient by design -- a deleted question is kept for 30 days and
# then dropped automatically, so this is churn rather than content
data/recycled.json
data/banks/*/recycled.json

# secrets
.env

# download leftovers
web/vendor/katex.tar.gz
web/vendor/*.tar.gz

# Audit snapshots from the PDF comparison passes are kept in the repository on
# purpose: they are the record of how figures and questions were verified.
# (data/app.sqlite and the recycle bins above stay excluded.)

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# WorkBuddy session data & project memory notes (local only)
.workbuddy/

# build / verification intermediates (kept locally, not archived)
outputs/
scripts/figure_analysis.json
scripts/*.bak
server/*.bak

# data/ backup JSON and figure snapshots are archived in git -- see the audit
# note above. Only the live application state stays out.
