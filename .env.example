# Copy to .env and fill in to enable the optional AI polish step of the import pipeline.
# Any OpenAI-compatible endpoint works (OpenAI, Azure, local vLLM / Ollama gateway ...).

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: force a TeX engine instead of auto-detection
# LATEX_ENGINE=tectonic
